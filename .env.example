# Fluct-mcp (OSS) — environment
# Copy to `.env.local` and edit if you need to override defaults.
#
# Most solo installs don't need ANY of these. Defaults are chosen for
# "just works": PGlite database in ./.fluct/fluct.db, MCP on stdio.

# 'oss' (default, self-host) or 'saas'. Leave as-is for this repo.
FLUCT_MODE=oss

# Where PGlite stores the database file.
# Default: ./.fluct/fluct.db
# FLUCT_DB_PATH=./.fluct/fluct.db

# Optional: use an external Postgres instead of PGlite.
# If set, takes precedence over FLUCT_DB_PATH.
# FLUCT_DATABASE_URL=postgres://user:pass@localhost:5432/fluct

# MCP HTTP port (only when running HTTP transport; stdio is default).
# FLUCT_MCP_PORT=3001

# Web UI port.
# PORT=3000
