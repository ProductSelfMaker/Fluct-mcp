{
  "name": "fluct-mcp",
  "version": "0.1.0",
  "description": "AI-native service map for coding agents. Standard MCP, runs locally.",
  "license": "Apache-2.0",
  "type": "module",
  "homepage": "https://github.com/ProductSelfMaker/Fluct-mcp",
  "repository": {
    "type": "git",
    "url": "https://github.com/ProductSelfMaker/Fluct-mcp.git"
  },
  "bugs": "https://github.com/ProductSelfMaker/Fluct-mcp/issues",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-coding",
    "claude-code",
    "cursor",
    "service-map",
    "codebase-intelligence",
    "developer-tools"
  ],
  "bin": {
    "fluct-mcp": "./bin/fluct-mcp.js"
  },
  "files": [
    "bin/",
    "dist/",
    "src/db/migrations/"
  ],
  "scripts": {
    "dev": "tsx bin/fluct-mcp.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "db:init": "tsx src/db/migrate.ts",
    "format": "prettier --write ."
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "drizzle-orm": "^0.44.6",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
